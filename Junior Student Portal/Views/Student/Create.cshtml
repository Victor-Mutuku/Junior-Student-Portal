@using Junior_Student_Portal
@model Student

@{
    ViewBag.Title = "Add student";
}
<h1 class="text-center"> Add Student </h1>
<div class="row">
    <div class="container-fluid">
        <form method="post" asp-action="create">
            <div class="mt-3">
                <label asp-for="Name"> Name</label>
                <input type="text" class="form-control" placeholder="Enter name" asp-for="Name" />
            </div>

            <div class="mt-3">
                <label asp-for="Phone"> Phonenumber</label>
                <input type="tel" class="form-control" placeholder="Enter Phonenumber" asp-for="Phone" />
            </div>

            <div class="mt-3">
                <label asp-for="Email" class="form-label">Email:</label>
                <input type="email" class="form-control" placeholder="Enter email" asp-for="Email" />
            </div>

            <div class="mt-3">
                <label asp-for="Age" class="form-label">Age:</label>
                <input type="number" class="form-control" placeholder="Enter Age" asp-for="Age" />
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>
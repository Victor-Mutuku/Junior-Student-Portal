@using Junior_Student_Portal
@model Student

<h1 class="text-center">Delete Student</h1>
<div class="container-fluid">
    <div class="row">
        <div class="card-body">
            <p class="text-danger">You want to delete?</p>
            <form asp-action="Delete" method="post">
                <input type="hidden"class="form-control" asp-for="Id" hidden />
                <div class="mt-3">
                    <label asp-for="Name"> Name</label>
                    <input type="text" class="form-control" value="@Model.Name" readonly/>
                </div>

                <div class="mt-3">
                    <label asp-for="Phone"> Phonenumber</label>
                    <input type="tel" class="form-control"  value="@Model.Phone" readonly/>
                </div>

                <div class="mt-3">
                    <label asp-for="Email" class="form-label">Email:</label>
                    <input type="email" class="form-control" value="@Model.Email" readonly/>
                </div>

                <div class="mt-3">
                    <label asp-for="Age" class="form-label">Age:</label>
                    <input type="number" class="form-control" value="@Model.Age" readonly/>
                </div>
                <div class="mt-3">
                    < button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>
</div>